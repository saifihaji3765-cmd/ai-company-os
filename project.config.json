{
  "project": {
    "name": "AI Company OS",
    "codeName": "ai-company-os",
    "version": "0.1.0",
    "stage": "development",
    "type": "autonomous-ai-operating-system"
  },

  "system": {
    "mode": "owner-controlled",
    "architecture": "agent-based",
    "securityLevel": "high",
    "mobileFirst": true
  },

  "coreEngines": {
    "taskEngine": true,
    "contextEngine": true,
    "decisionEngine": true,
    "memoryEngine": true,
    "workflowEngine": true,
    "integrationHub": true
  },

  "departments": {
    "revenue": true,
    "production": true,
    "customerSuccess": true,
    "businessIntelligence": true,
    "operations": true
  },

  "agentSystem": {
    "enabled": true,
    "humanApproval": true,
    "autoExecution": false,
    "auditLogging": true
  },

  "notifications": {
    "push": true,
    "whatsapp": true,
    "email": true
  },

  "database": {
    "primary": "postgresql",
    "cache": "redis"
  },

  "development": {
    "apiVersion": "v1",
    "environment": "local",
    "dockerSupport": true
  },

  "rules": [
    "Critical actions require approval",
    "All agent actions must be logged",
    "No agent can bypass permissions",
    "Security comes before automation"
  ]
}
